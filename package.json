{
  "name": "hooks-compiler",
  "version": "0.1.0",
  "description": "Deterministic Xahau C Hook compiler: clang, lld, wasm-opt and hook-cleaner, all running as WebAssembly in the browser or Node",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./worker": { "types": "./dist/worker.d.ts", "default": "./dist/worker.js" }
  },
  "bin": { "hooks-compiler": "./dist/cli.js" },
  "files": ["dist"],
  "scripts": {
    "prepare": "node --experimental-strip-types scripts/build-cleaner.ts && clang-wasm-copy-assets public/clang",
    "build": "tsc -p tsconfig.build.json && cp src/hook-cleaner.wasm dist/",
    "build:worker": "vite build --config vite.worker.config.ts",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@live-codes/clang-wasm": "0.3.0",
    "binaryen": "132.0.0"
  },
  "devDependencies": {
    "@digital-go-jp/design-tokens": "^2.0.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
